.claude/settings.local.json
.claude/.cc-writes/

# The real git dir. `.git` is a one-line pointer file (gitdir: .gitdir)
# because the Claude sandbox hard-denies all writes to a path named `.git`
# but allows `.gitdir`. Git only auto-excludes `.git`, so this needs an
# explicit rule. See CLAUDE.md "Git setup".
.gitdir/

# larc
tools/discovery-probe
tools/palette-probe
discovery-dump.json

# mitmproxy capture files (may contain device tokens)
*.mitm
eqv2.txt

# The drop-off copy; the tracked one lives in larc/Resources.
/larc-logo.png

# Research tooling and captures. These carry the maintainer's LAN addresses and
# raw device dumps; they stay local for reference and are never published.
tools/
*.json
!larc.xcodeproj/**/*.json

# Local notes: device addresses and anything else host-specific.
PRIVATE.md
